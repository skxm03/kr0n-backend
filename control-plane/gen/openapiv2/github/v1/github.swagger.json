{
  "swagger": "2.0",
  "info": {
    "title": "kr0n GitHub VCS Service API",
    "description": "GitHub Version Control System microservice for repository exploration, branch indexing, and directory discovery.",
    "version": "1.0.0",
    "contact": {
      "name": "kr0n engineering",
      "url": "https://github.com/skxm03/kr0n-backend"
    }
  },
  "tags": [
    {
      "name": "GitHub Repositories \u0026 VCS",
      "description": "Explore repositories, branches, and directory trees connected via GitHub App installations."
    }
  ],
  "host": "localhost:8080",
  "schemes": [
    "http"
  ],
  "consumes": [
    "application/json"
  ],
  "produces": [
    "application/json"
  ],
  "paths": {
    "/api/v1/orgs/{org_id}/github/repositories": {
      "get": {
        "summary": "List accessible GitHub repositories",
        "description": "Queries the GitHub API via installation credentials to list all repositories accessible to the linked organization installation. Requires `github:read`.",
        "operationId": "GitHubService_ListRepositories",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1ListRepositoriesResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "org_id",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "caller.user_id",
            "in": "query",
            "required": false,
            "type": "string"
          },
          {
            "name": "caller.kind",
            "in": "query",
            "required": false,
            "type": "string"
          },
          {
            "name": "caller.token_org_id",
            "in": "query",
            "required": false,
            "type": "string"
          },
          {
            "name": "caller.token_permissions",
            "in": "query",
            "required": false,
            "type": "array",
            "items": {
              "type": "string"
            },
            "collectionFormat": "multi"
          },
          {
            "name": "caller.session_id",
            "in": "query",
            "required": false,
            "type": "string"
          },
          {
            "name": "installation_id",
            "in": "query",
            "required": false,
            "type": "string",
            "format": "int64"
          }
        ],
        "tags": [
          "GitHub Repositories \u0026 VCS"
        ],
        "security": [
          {
            "BearerAuth": []
          }
        ]
      }
    },
    "/api/v1/orgs/{org_id}/github/repositories/{owner}/{repo}/branches": {
      "get": {
        "summary": "List repository branches",
        "description": "Returns branch names, latest commit SHAs, and protection status for a given GitHub repository. Requires `github:read`.",
        "operationId": "GitHubService_ListBranches",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1ListBranchesResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "org_id",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "owner",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "repo",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "caller.user_id",
            "in": "query",
            "required": false,
            "type": "string"
          },
          {
            "name": "caller.kind",
            "in": "query",
            "required": false,
            "type": "string"
          },
          {
            "name": "caller.token_org_id",
            "in": "query",
            "required": false,
            "type": "string"
          },
          {
            "name": "caller.token_permissions",
            "in": "query",
            "required": false,
            "type": "array",
            "items": {
              "type": "string"
            },
            "collectionFormat": "multi"
          },
          {
            "name": "caller.session_id",
            "in": "query",
            "required": false,
            "type": "string"
          },
          {
            "name": "installation_id",
            "in": "query",
            "required": false,
            "type": "string",
            "format": "int64"
          }
        ],
        "tags": [
          "GitHub Repositories \u0026 VCS"
        ],
        "security": [
          {
            "BearerAuth": []
          }
        ]
      }
    },
    "/api/v1/orgs/{org_id}/github/repositories/{owner}/{repo}/directories": {
      "get": {
        "summary": "List repository directory structure",
        "description": "Discovers canonical directory structures (e.g. root '/', monorepo app subdirectories) at a given git commit/ref to assist workspace discovery. Requires `github:read`.",
        "operationId": "GitHubService_ListDirectories",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1ListDirectoriesResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "org_id",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "owner",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "repo",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "caller.user_id",
            "in": "query",
            "required": false,
            "type": "string"
          },
          {
            "name": "caller.kind",
            "in": "query",
            "required": false,
            "type": "string"
          },
          {
            "name": "caller.token_org_id",
            "in": "query",
            "required": false,
            "type": "string"
          },
          {
            "name": "caller.token_permissions",
            "in": "query",
            "required": false,
            "type": "array",
            "items": {
              "type": "string"
            },
            "collectionFormat": "multi"
          },
          {
            "name": "caller.session_id",
            "in": "query",
            "required": false,
            "type": "string"
          },
          {
            "name": "installation_id",
            "in": "query",
            "required": false,
            "type": "string",
            "format": "int64"
          },
          {
            "name": "ref",
            "in": "query",
            "required": false,
            "type": "string"
          }
        ],
        "tags": [
          "GitHub Repositories \u0026 VCS"
        ],
        "security": [
          {
            "BearerAuth": []
          }
        ]
      }
    }
  },
  "definitions": {
    "protobufAny": {
      "type": "object",
      "properties": {
        "@type": {
          "type": "string"
        }
      },
      "additionalProperties": {}
    },
    "rpcStatus": {
      "type": "object",
      "properties": {
        "code": {
          "type": "integer",
          "format": "int32"
        },
        "message": {
          "type": "string"
        },
        "details": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/protobufAny"
          }
        }
      }
    },
    "v1CallerPrincipal": {
      "type": "object",
      "properties": {
        "user_id": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "token_org_id": {
          "type": "string"
        },
        "token_permissions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "session_id": {
          "type": "string"
        }
      }
    },
    "v1GitHubBranchInfo": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "commit_sha": {
          "type": "string"
        },
        "protected": {
          "type": "boolean"
        }
      }
    },
    "v1GitHubRepositoryInfo": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "int64"
        },
        "owner": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "full_name": {
          "type": "string"
        },
        "private": {
          "type": "boolean"
        },
        "default_branch": {
          "type": "string"
        },
        "html_url": {
          "type": "string"
        }
      }
    },
    "v1ListBranchesResponse": {
      "type": "object",
      "properties": {
        "branches": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/v1GitHubBranchInfo"
          }
        }
      }
    },
    "v1ListDirectoriesResponse": {
      "type": "object",
      "properties": {
        "directories": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "v1ListRepositoriesResponse": {
      "type": "object",
      "properties": {
        "repositories": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/v1GitHubRepositoryInfo"
          }
        }
      }
    }
  },
  "securityDefinitions": {
    "BearerAuth": {
      "type": "apiKey",
      "description": "Standard JWT Bearer token format: `Bearer \u003caccess_token\u003e`",
      "name": "Authorization",
      "in": "header"
    }
  }
}
