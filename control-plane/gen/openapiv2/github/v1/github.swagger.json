{
  "swagger": "2.0",
  "info": {
    "title": "kr0n GitHub VCS Service API",
    "description": "GitHub Version Control System microservice for repository exploration, branch indexing, directory discovery, and GitHub App installations.",
    "version": "1.0.0",
    "contact": {
      "name": "kr0n engineering",
      "url": "https://github.com/skxm03/kr0n-backend"
    }
  },
  "tags": [
    {
      "name": "GitHub Repositories \u0026 VCS",
      "description": "Explore repositories, branches, and directory trees connected via GitHub App installations."
    },
    {
      "name": "GitHub App Integrations",
      "description": "Install, link, and manage organization GitHub App installations."
    }
  ],
  "host": "localhost:8080",
  "schemes": [
    "http"
  ],
  "consumes": [
    "application/json"
  ],
  "produces": [
    "application/json"
  ],
  "paths": {
    "/api/v1/orgs/{org_id}/github/installations/start": {
      "get": {
        "summary": "Start GitHub App installation",
        "description": "Initiates the GitHub App installation flow by generating a cryptographically signed HMAC state token and redirect URL. Requires `org:update`.",
        "operationId": "GitHubService_StartGitHubInstallation",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1StartGitHubInstallationResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "org_id",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "caller.user_id",
            "in": "query",
            "required": false,
            "type": "string"
          },
          {
            "name": "caller.kind",
            "in": "query",
            "required": false,
            "type": "string"
          },
          {
            "name": "caller.token_org_id",
            "in": "query",
            "required": false,
            "type": "string"
          },
          {
            "name": "caller.token_permissions",
            "in": "query",
            "required": false,
            "type": "array",
            "items": {
              "type": "string"
            },
            "collectionFormat": "multi"
          },
          {
            "name": "caller.session_id",
            "in": "query",
            "required": false,
            "type": "string"
          }
        ],
        "tags": [
          "GitHub App Integrations"
        ],
        "security": [
          {
            "BearerAuth": []
          }
        ]
      }
    },
    "/api/v1/orgs/{org_id}/github/installations": {
      "get": {
        "summary": "List GitHub App installations",
        "description": "Returns all active or suspended GitHub App installations associated with the specified organization. Requires `org:read`.",
        "operationId": "GitHubService_ListGitHubInstallations",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1ListGitHubInstallationsResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "org_id",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "caller.user_id",
            "in": "query",
            "required": false,
            "type": "string"
          },
          {
            "name": "caller.kind",
            "in": "query",
            "required": false,
            "type": "string"
          },
          {
            "name": "caller.token_org_id",
            "in": "query",
            "required": false,
            "type": "string"
          },
          {
            "name": "caller.token_permissions",
            "in": "query",
            "required": false,
            "type": "array",
            "items": {
              "type": "string"
            },
            "collectionFormat": "multi"
          },
          {
            "name": "caller.session_id",
            "in": "query",
            "required": false,
            "type": "string"
          }
        ],
        "tags": [
          "GitHub App Integrations"
        ],
        "security": [
          {
            "BearerAuth": []
          }
        ]
      },
      "post": {
        "summary": "Complete GitHub App installation",
        "description": "Verifies the HMAC state token, fetches installation metadata from GitHub, and links the installation to the organization. Requires `org:update`.",
        "operationId": "GitHubService_CompleteGitHubInstallation",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1CompleteGitHubInstallationResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "org_id",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/GitHubServiceCompleteGitHubInstallationBody"
            }
          }
        ],
        "tags": [
          "GitHub App Integrations"
        ],
        "security": [
          {
            "BearerAuth": []
          }
        ]
      }
    },
