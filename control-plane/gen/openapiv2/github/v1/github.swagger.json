          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "org_id",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "installation_id",
            "in": "path",
            "required": true,
            "type": "string",
            "format": "int64"
          },
          {
            "name": "caller.user_id",
            "in": "query",
            "required": false,
            "type": "string"
          },
          {
            "name": "caller.kind",
            "in": "query",
            "required": false,
            "type": "string"
          },
          {
            "name": "caller.token_org_id",
            "in": "query",
            "required": false,
            "type": "string"
          },
          {
            "name": "caller.token_permissions",
            "in": "query",
            "required": false,
            "type": "array",
            "items": {
              "type": "string"
            },
            "collectionFormat": "multi"
          },
          {
            "name": "caller.session_id",
            "in": "query",
            "required": false,
            "type": "string"
          }
        ],
        "tags": [
          "GitHub App Integrations"
        ],
        "security": [
          {
            "BearerAuth": []
          }
        ]
      }
    },
