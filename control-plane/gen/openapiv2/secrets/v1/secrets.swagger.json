{
  "swagger": "2.0",
  "info": {
    "title": "kr0n Secrets \u0026 Vault API",
    "description": "Dedicated zero-trust microservice for envelope-encrypted Project Secrets \u0026 Environment Variables (AES-256-GCM with AAD).",
    "version": "1.0.0",
    "contact": {
      "name": "kr0n engineering",
      "url": "https://github.com/skxm03/kr0n-backend"
    }
  },
  "tags": [
    {
      "name": "Project Secrets \u0026 Environment Variables",
      "description": "Write-only envelope-encrypted project secrets and environment variables (AES-256-GCM with AAD)."
    }
  ],
  "host": "localhost:8080",
  "schemes": [
    "http"
  ],
  "consumes": [
    "application/json"
  ],
  "produces": [
    "application/json"
  ],
  "paths": {
    "/api/v1/orgs/{org_id}/projects/{project_id}/env": {
      "get": {
        "summary": "List project environment variables (masked metadata only)",
        "description": "Lists environment variable keys, timestamps, and masked value indicators (`••••••••`) for a project and environment without decrypting or exposing secret values. Requires `project:read`.",
        "operationId": "SecretsService_ListProjectEnvVars",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1ListProjectEnvVarsResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "org_id",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "project_id",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "caller.user_id",
            "in": "query",
            "required": false,
            "type": "string"
          },
          {
            "name": "caller.kind",
            "in": "query",
            "required": false,
            "type": "string"
          },
          {
            "name": "caller.token_org_id",
            "in": "query",
            "required": false,
            "type": "string"
          },
          {
            "name": "caller.token_permissions",
            "in": "query",
            "required": false,
            "type": "array",
            "items": {
              "type": "string"
            },
            "collectionFormat": "multi"
          },
          {
            "name": "caller.session_id",
            "in": "query",
            "required": false,
            "type": "string"
          },
          {
            "name": "environment",
            "in": "query",
            "required": false,
            "type": "string"
          }
        ],
        "tags": [
          "Project Secrets \u0026 Environment Variables"
        ],
        "security": [
          {
            "BearerAuth": []
          }
        ]
      },
      "post": {
        "summary": "Upsert write-only encrypted project environment variables",
        "description": "Encrypts and stores one or more environment variables for a project using AES-256-GCM envelope encryption with AAD. Returns only masked metadata (`••••••••`); plaintext is never returned. Requires `project:update`.",
        "operationId": "SecretsService_UpsertProjectEnvVars",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1UpsertProjectEnvVarsResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "org_id",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "project_id",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/SecretsServiceUpsertProjectEnvVarsBody"
            }
          }
        ],
        "tags": [
          "Project Secrets \u0026 Environment Variables"
        ],
        "security": [
          {
            "BearerAuth": []
          }
        ]
      }
    },
    "/api/v1/orgs/{org_id}/projects/{project_id}/env/{key}": {
      "delete": {
        "summary": "Delete project environment variable",
        "description": "Permanently deletes an environment variable by key for the specified project and environment. Requires `project:update`.",
        "operationId": "SecretsService_DeleteProjectEnvVar",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1DeleteProjectEnvVarResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "org_id",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "project_id",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "key",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "caller.user_id",
            "in": "query",
            "required": false,
            "type": "string"
          },
          {
            "name": "caller.kind",
            "in": "query",
            "required": false,
            "type": "string"
          },
          {
            "name": "caller.token_org_id",
            "in": "query",
            "required": false,
            "type": "string"
          },
          {
            "name": "caller.token_permissions",
            "in": "query",
            "required": false,
            "type": "array",
            "items": {
              "type": "string"
            },
            "collectionFormat": "multi"
          },
          {
            "name": "caller.session_id",
            "in": "query",
            "required": false,
            "type": "string"
          },
          {
            "name": "environment",
            "in": "query",
            "required": false,
            "type": "string"
          }
        ],
        "tags": [
          "Project Secrets \u0026 Environment Variables"
        ],
        "security": [
          {
            "BearerAuth": []
          }
        ]
      }
    }
  },
