        "parameters": [
          {
            "name": "org_id",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "project_id",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "caller.user_id",
            "in": "query",
            "required": false,
            "type": "string"
          },
          {
            "name": "caller.kind",
            "in": "query",
            "required": false,
            "type": "string"
          },
          {
            "name": "caller.token_org_id",
            "in": "query",
            "required": false,
            "type": "string"
          },
          {
            "name": "caller.token_permissions",
            "in": "query",
            "required": false,
            "type": "array",
            "items": {
              "type": "string"
            },
            "collectionFormat": "multi"
          },
          {
            "name": "caller.session_id",
            "in": "query",
            "required": false,
            "type": "string"
          }
        ],
        "tags": [
          "Projects \u0026 Build Settings"
        ],
        "security": [
          {
            "BearerAuth": []
          }
        ]
      },
      "patch": {
        "summary": "Update project configuration",
        "description": "Updates project metadata, root directory, production branch, or application preset, atomically incrementing the project revision number. Requires `project:update`.",
        "operationId": "ServiceManagerService_UpdateProject",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1UpdateProjectResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "org_id",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "project_id",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/ServiceManagerServiceUpdateProjectBody"
            }
          }
        ],
        "tags": [
          "Projects \u0026 Build Settings"
        ],
        "security": [
          {
            "BearerAuth": []
          }
        ]
      }
    },
    "/api/v1/orgs/{org_id}/projects/{project_id}/build-settings": {
      "put": {
        "summary": "Update project build settings",
        "description": "Updates a project's install command, build command, and output directory along with their explicit on/off override toggles, atomically incrementing the project revision. Requires `project:update`.",
        "operationId": "ServiceManagerService_UpdateProjectBuildSettings",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1UpdateProjectBuildSettingsResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "org_id",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "project_id",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/ServiceManagerServiceUpdateProjectBuildSettingsBody"
            }
          }
        ],
        "tags": [
          "Projects \u0026 Build Settings"
        ],
        "security": [
          {
            "BearerAuth": []
          }
        ]
      }
    }
