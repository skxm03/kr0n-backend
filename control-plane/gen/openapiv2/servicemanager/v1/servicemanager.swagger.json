{
  "swagger": "2.0",
  "info": {
    "title": "kr0n Service Manager API",
    "description": "Control-plane microservice for repository-linked Projects, Railpack Application Presets, and toggleable Build Settings.",
    "version": "1.0.0",
    "contact": {
      "name": "kr0n engineering",
      "url": "https://github.com/skxm03/kr0n-backend"
    }
  },
  "tags": [
    {
      "name": "Application Presets",
      "description": "Railpack-aligned application presets and default build configuration templates."
    },
    {
      "name": "Projects \u0026 Build Settings",
      "description": "Manage organization-scoped, GitHub repository-linked projects and toggleable build commands."
    }
  ],
  "host": "localhost:8080",
  "schemes": [
    "http"
  ],
  "consumes": [
    "application/json"
  ],
  "produces": [
    "application/json"
  ],
  "paths": {
    "/api/v1/presets": {
      "get": {
        "summary": "List supported application presets",
        "description": "Returns the catalog of Railpack-aligned application presets (e.g. auto, nextjs, vite, go, python, rust, dockerfile, static) and their default install/build/output settings.",
        "operationId": "ServiceManagerService_ListApplicationPresets",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1ListApplicationPresetsResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "tags": [
          "Application Presets"
        ],
        "security": [
          {
            "BearerAuth": []
          }
        ]
      }
    },
    "/api/v1/orgs/{org_id}/projects": {
      "get": {
        "summary": "List organization projects",
        "description": "Lists all projects and their build settings within an organization workspace. Requires `project:read`.",
        "operationId": "ServiceManagerService_ListProjects",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1ListProjectsResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "org_id",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "caller.user_id",
            "in": "query",
            "required": false,
            "type": "string"
          },
          {
            "name": "caller.kind",
            "in": "query",
            "required": false,
            "type": "string"
          },
          {
            "name": "caller.token_org_id",
            "in": "query",
            "required": false,
            "type": "string"
          },
          {
            "name": "caller.token_permissions",
            "in": "query",
            "required": false,
            "type": "array",
            "items": {
              "type": "string"
            },
            "collectionFormat": "multi"
          },
          {
            "name": "caller.session_id",
            "in": "query",
            "required": false,
            "type": "string"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "type": "integer",
            "format": "int32"
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "type": "integer",
            "format": "int32"
          }
        ],
        "tags": [
          "Projects \u0026 Build Settings"
        ],
        "security": [
          {
            "BearerAuth": []
          }
        ]
      },
      "post": {
        "summary": "Create a repository-linked project",
        "description": "Creates an organization-scoped project linked to an active GitHub App installation repository with root directory, application preset, and toggleable build settings. Requires `project:create`.",
        "operationId": "ServiceManagerService_CreateProject",
        "responses": {
          "200": {
            "description": "A successful response.",
            "schema": {
              "$ref": "#/definitions/v1CreateProjectResponse"
            }
          },
          "default": {
            "description": "An unexpected error response.",
            "schema": {
              "$ref": "#/definitions/rpcStatus"
            }
          }
        },
        "parameters": [
          {
            "name": "org_id",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "$ref": "#/definitions/ServiceManagerServiceCreateProjectBody"
            }
          }
        ],
        "tags": [
          "Projects \u0026 Build Settings"
        ],
        "security": [
          {
            "BearerAuth": []
          }
        ]
      }
    },
