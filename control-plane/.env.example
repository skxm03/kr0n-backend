# Environment mode ("dev" allows default Ed25519 dev keys and plaintext gRPC; non-dev requires explicit keys & TLS)
KR0N_ENV=dev

# PostgreSQL (authoritative control-plane state)
DATABASE_URL=postgres://kr0n:kr0n_dev_password@localhost:5432/kr0n?sslmode=disable

# Redis (ephemeral state: leaky-bucket rate limiting)
REDIS_ADDR=localhost:6379

# Service bind/target addresses
AUTH_GRPC_ADDR=:50051
GATEWAY_HTTP_ADDR=:8080

# Auth <-> Gateway gRPC TLS & mTLS (Mandatory mutual TLS when KR0N_ENV != dev)
# Auth server TLS configuration (server cert, private key, and trusted client CA)
AUTH_GRPC_TLS_CERT_FILE=
AUTH_GRPC_TLS_KEY_FILE=
AUTH_GRPC_CLIENT_CA_FILE=
AUTH_GRPC_ALLOWED_CLIENTS=kr0n-gateway
# Gateway mTLS client configuration (presenting client cert/key to Auth, verifying Auth server CA)
AUTH_GRPC_TLS_CA_FILE=
GATEWAY_GRPC_TLS_CERT_FILE=
GATEWAY_GRPC_TLS_KEY_FILE=
# Expected Auth server certificate SAN/hostname (required if AUTH_GRPC_ADDR is an IP; defaults to target host if DNS name)
AUTH_GRPC_SERVER_NAME=auth.internal
# Optional defense-in-depth shared service token (when set in non-dev, BOTH valid mTLS cert AND service token are required)
AUTH_SERVICE_TOKEN=

# Ed25519 JWT signing & verification (base64 32-byte seed or 64-byte private key; required when KR0N_ENV != dev)
JWT_KEY_ID=k1
JWT_PRIVATE_KEY=
# Comma-separated kid:base64_ed25519_pubkey entries (gateway fetches JWKS from auth gRPC automatically)
JWT_PUBLIC_KEYS=
JWT_ISSUER=kr0n-auth
JWT_AUDIENCE=kr0n-api
ACCESS_TOKEN_LIFETIME=15m
REFRESH_TOKEN_LIFETIME=720h
EMAIL_VERIFICATION_TOKEN_LIFETIME=24h
PASSWORD_RESET_TOKEN_LIFETIME=1h
REQUIRE_VERIFIED_EMAIL=false

# SMTP / Mailpit (compose exposes SMTP on 1025 and Web UI on 8025)
SMTP_ADDR=localhost:1025
SMTP_FROM=noreply@kr0n.dev
SMTP_USERNAME=
SMTP_PASSWORD=

# GitHub OAuth 2.0 + PKCE (endpoints return 503 not_configured when unset)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URL=http://localhost:8080/api/v1/auth/github/callback

# Gateway rate limiting (leaky bucket) & proxy trust
TRUSTED_PROXY_CIDRS=
RATE_LIMIT_CAPACITY=120
RATE_LIMIT_PER_SEC=20
AUTH_RATE_LIMIT_CAPACITY=10
AUTH_RATE_LIMIT_PER_SEC=0.2

