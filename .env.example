# ==============================================================================
# kr0n Local Development & Production Environment Configuration
# ==============================================================================

# Environment mode ("dev" allows default Ed25519 dev keys and plaintext gRPC; non-dev requires explicit keys & TLS)
KR0N_ENV=dev

# ------------------------------------------------------------------------------
# PostgreSQL (authoritative control-plane state)
# For local dev via Docker Compose, Postgres is exposed on host port 5433 (5433:5432).
# ------------------------------------------------------------------------------
DATABASE_URL=postgres://kr0n:kr0n_dev_password@localhost:5433/kr0n?sslmode=disable
AUTH_POSTGRES_USER=kr0n
AUTH_POSTGRES_PASSWORD=kr0n_dev_password
AUTH_POSTGRES_DB=kr0n
AUTH_POSTGRES_HOST_PORT=5433

# ------------------------------------------------------------------------------
# Redis (ephemeral state: leaky-bucket rate limiting)
# ------------------------------------------------------------------------------
REDIS_ADDR=localhost:6379

# ------------------------------------------------------------------------------
# RabbitMQ & Mailer Service
# (Docker Compose exposes AMQP on 5672, RabbitMQ UI on 15672, Mailpit SMTP on 1025, Mailpit UI on 8025)
# ------------------------------------------------------------------------------
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
EMAIL_QUEUE_NAME=email.jobs
EMAIL_BATCH_SIZE=20
EMAIL_BATCH_TIMEOUT=2s
EMAIL_BATCH_WORKERS=5
SMTP_ADDR=localhost:1025
SMTP_FROM=noreply@kr0n.dev
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_TIMEOUT=10s

# ------------------------------------------------------------------------------
# Auth Microservice
# ------------------------------------------------------------------------------
AUTH_GRPC_ADDR=127.0.0.1:50051

# Ed25519 JWT signing & verification (base64 32-byte seed or 64-byte private key; generated ephemerally in dev if unset)
JWT_KEY_ID=k1
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEYS=
JWT_ISSUER=kr0n-auth
JWT_AUDIENCE=kr0n-api
ACCESS_TOKEN_LIFETIME=15m
REFRESH_TOKEN_LIFETIME=720h
EMAIL_VERIFICATION_TOKEN_LIFETIME=24h
PASSWORD_RESET_TOKEN_LIFETIME=1h
REQUIRE_VERIFIED_EMAIL=false

# Auth TLS & mTLS settings (run 'make certs' to generate local certificates)
AUTH_GRPC_TLS_CERT_FILE=certs/auth/server.crt
AUTH_GRPC_TLS_KEY_FILE=certs/auth/server.key
AUTH_GRPC_CLIENT_CA_FILE=certs/ca/ca.crt
AUTH_GRPC_ALLOWED_CLIENTS=kr0n-gateway,kr0n-github,gateway

# ------------------------------------------------------------------------------
# GitHub App & OAuth (Auth Service & GitHub Service)
# ------------------------------------------------------------------------------
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URL=http://localhost:8080/api/v1/auth/github/callback
FRONTEND_URL=http://localhost:3000
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY=keys/kr0n-app.2026-11-20.private-key.pem
GITHUB_APP_PRIVATE_KEY_PATH=keys/kr0n-app.2026-11-20.private-key.pem
GITHUB_APP_STATE_SECRET=
GITHUB_WEBHOOK_SECRET=your_github_webhook_secret_here
GITHUB_WEBHOOK_MAX_BYTES=10485760

# ------------------------------------------------------------------------------
# API Gateway Service
# ------------------------------------------------------------------------------
GATEWAY_HTTP_ADDR=:8080
GATEWAY_CONFIG_PATH=gateway.yaml
TRUSTED_PROXY_CIDRS=

# Gateway mTLS client configuration (dialing Auth & GitHub upstreams)
AUTH_GRPC_TLS_CA_FILE=certs/ca/ca.crt
GATEWAY_GRPC_TLS_CERT_FILE=certs/gateway/client.crt
GATEWAY_GRPC_TLS_KEY_FILE=certs/gateway/client.key
AUTH_GRPC_SERVER_NAME=auth.internal

# ------------------------------------------------------------------------------
# GitHub Microservice (VCS Proxy & Tree Service)
# ------------------------------------------------------------------------------
GITHUB_GRPC_PORT=50052
GITHUB_GRPC_ADDR=127.0.0.1:50052
GITHUB_API_URL=https://api.github.com
GITHUB_HTTP_TIMEOUT=5s
GITHUB_CACHE_TTL=2m
GITHUB_MAX_RESPONSE_BYTES=4194304

# GitHub microservice TLS / mTLS configuration
GITHUB_TLS_ENABLED=true
GITHUB_TLS_CERT_FILE=certs/github/server.crt
GITHUB_TLS_KEY_FILE=certs/github/server.key
GITHUB_TLS_CA_FILE=certs/ca/ca.crt
GITHUB_TLS_CLIENT_AUTH=true
GITHUB_INSECURE_DEV_SKIP_VERIFY=false
GITHUB_GRPC_SERVER_NAME=github.internal
GITHUB_GRPC_TLS_CA_FILE=certs/ca/ca.crt

# ------------------------------------------------------------------------------
# Service Manager Microservice (Projects, Presets & Build Settings)
# ------------------------------------------------------------------------------
SERVICEMANAGER_GRPC_ADDR=127.0.0.1:50053
SERVICEMANAGER_GRPC_SERVER_NAME=servicemanager.internal

# ------------------------------------------------------------------------------
# Secrets & Vault Microservice (Envelope Encryption: Master KEK & Project DEKs)
# ------------------------------------------------------------------------------
SECRETS_GRPC_ADDR=127.0.0.1:50054
SECRETS_GRPC_SERVER_NAME=secrets.internal
SECRETS_MASTER_KEK_PATH=keys/kr0n-kek.key
SECRETS_MASTER_KEK_VERSION=1

# ------------------------------------------------------------------------------
# Google OAuth (Auth Service)
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=placeholder-google-client-id
GOOGLE_CLIENT_SECRET=placeholder-google-client-secret
GOOGLE_REDIRECT_URL=http://localhost:8080/api/v1/auth/google/callback
